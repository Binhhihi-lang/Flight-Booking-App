<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Cấu hình internet -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" /> <!-- Mở quyền đọc ghi ứng dụng -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.FlightBookingApp">
        <activity
            android:name=".ui.view.activity.SeatSelectionActivity"
            android:exported="false" />
        <activity
            android:name=".ui.view.activity.PassengerInputActivity"
            android:exported="false" />
        <activity
            android:name=".ui.view.activity.BookingInfoActivity"
            android:exported="false" />
        <activity
            android:name=".ui.view.activity.SearchCityActivity"
            android:exported="false" />
        <activity
            android:name=".ui.view.activity.SearchFlightActivity"
            android:exported="false" />
        <activity
            android:name=".ui.view.activity.MainActivity"
            android:exported="false" />
        <activity
            android:name=".ui.view.activity.ForgotPasswordActivity"
            android:exported="false" />
        <activity
            android:name=".ui.view.activity.UserEditProfileActivity"
            android:exported="false" />
        <activity
            android:name=".ui.view.activity.SignupActivity"
            android:exported="false" />
        <activity
            android:name=".ui.view.activity.LoginActivity"
            android:exported="true"
            android:label="Login" />
        <activity
            android:name=".ui.view.activity.SplashActivity"
            android:exported="true">

            <!-- Mở lên đầu tiên -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

    </application>

</manifest>
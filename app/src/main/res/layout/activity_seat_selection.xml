<?xml version="1.0" encoding="utf-8"?>

<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F8"
    tools:context=".ui.view.activity.SeatSelectionActivity">

    <!-- ══════════════════════════════════════════
         APPBAR: Toolbar + Tab Row
         ══════════════════════════════════════════ -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar_seat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_blue"
        app:elevation="4dp">

        <!-- Toolbar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_seat"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:layout_marginTop="28dp"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="@color/white"
            app:title="Chọn ghế ngồi"
            app:titleTextColor="@color/white" />

        <!-- Tab Row: LƯỢT ĐI | LƯỢT VỀ -->
        <!-- gone khi 1 chiều, visible khi khứ hồi -->
        <LinearLayout
            android:id="@+id/layout_seat_tab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="visible"
            tools:visibility="visible">

            <!-- Tab LƯỢT ĐI -->
            <TextView
                android:id="@+id/tab_seat_depart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:text="LƯỢT ĐI"
                android:textColor="#333333"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_seat_tab_selected"
                 />

            <!-- Tab LƯỢT VỀ -->
            <TextView
                android:id="@+id/tab_seat_return"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:text="LƯỢT VỀ"
                android:textColor="#333333"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_seat_tab_unselected"
                 />

        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_booking"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingBottom="120dp"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/layout_seat_body"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingBottom="140dp"
            android:clipToPadding="false"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <!-- ────────────────────────────────────────
                 LEFT COLUMN: Legend + Airline + Seat Map
                 ──────────────────────────────────────── -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/scroll_seat_map"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#F0F4F8">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="12dp"
                    android:paddingHorizontal="10dp"
                    android:paddingBottom="16dp">

                    <!-- ── LEGEND (6 loại ghế) ───────────────── -->
                    <LinearLayout
                        android:id="@+id/layout_legend"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_legend_card"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="10dp"
                        android:layout_marginBottom="14dp">

                        <!-- Ghế cao cấp -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="7dp">

                            <View
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:background="@drawable/bg_seat_premium"
                                android:layout_marginEnd="10dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ghế cao cấp"
                                android:textColor="#333333"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <!-- Ghế hàng trước -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="7dp">

                            <View
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:background="@drawable/bg_seat_front"
                                android:layout_marginEnd="10dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ghế hàng trước"
                                android:textColor="#333333"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <!-- Ghế tiêu chuẩn -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="7dp">

                            <View
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:background="@drawable/bg_seat_standard"
                                android:layout_marginEnd="10dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ghế tiêu chuẩn"
                                android:textColor="#333333"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <!-- Ghế để chân rộng -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="7dp">

                            <View
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:background="@drawable/bg_seat_exit_row"
                                android:layout_marginEnd="10dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ghế để chân rộng"
                                android:textColor="#333333"
                                android:textSize="13sp"
                                android:maxWidth="120dp"
                                android:ellipsize="end"
                                android:singleLine="true" />
                        </LinearLayout>

                        <!-- Ghế đang chọn -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="7dp">

                            <View
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:background="@drawable/bg_seat_selecting"
                                android:layout_marginEnd="10dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ghế đang chọn"
                                android:textColor="#333333"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <!-- Đã có người -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <View
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:background="@drawable/bg_seat_booked"
                                android:layout_marginEnd="10dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Đã có người"
                                android:textColor="#333333"
                                android:textSize="13sp" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- ── TÊN HÃNG BAY ───────────────────────── -->
                    <TextView
                        android:id="@+id/tv_seat_airline_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:gravity="center"
                        android:layout_marginBottom="10dp"
                        android:text="Vietjet Air"
                        android:textColor="#333333"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="Vietjet Air" />

                    <!-- ── SEAT MAP (RecyclerView) ────────────── -->
                    <!--
                        RecyclerView với GridLayoutManager hoặc custom adapter.
                        Mỗi item = 1 ô ghế (SeatItem).
                        Adapter phân biệt: số hàng (row number) vs ghế (A/B/C/D/E/F).
                        SpanCount = 7 (cột A B C | số | D E F).
                        Layout manager: GridLayoutManager(ctx, 7).
                    -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_seat_map"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        tools:itemCount="5"
                        tools:listitem="@layout/item_seat_cell" />

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- ────────────────────────────────────────
                 RIGHT COLUMN: Aircraft diagram + Route
                 Fixed, không scroll
                 ──────────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/layout_seat_right_panel"
                android:layout_width="90dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="#F0F4F8"
                android:paddingTop="16dp"
                android:paddingHorizontal="8dp">

                <!-- Icon máy bay -->
                <ImageView
                    android:id="@+id/img_aircraft_icon"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@drawable/ic_aircraft_top_view"
                    android:layout_marginBottom="4dp"
                    app:tint="@color/primary_blue" />

                <!-- Model tàu bay -->
                <TextView
                    android:id="@+id/tv_aircraft_model"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="A321"
                    android:textColor="#1A1A2E"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="20dp"
                    tools:text="A321" />

                <!-- Illustration: 2 ghế -->
                <ImageView
                    android:id="@+id/img_seat_illustration"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_seat_illustration"
                    app:tint="@color/primary_blue"
                    />
                <TextView
                    android:id="@+id/tv_seat_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#1A1A2E"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="20dp"
                    tools:text="4B" />

                <!-- Route diagram: FROM → plane → TO -->
                <TextView
                    android:id="@+id/tv_seat_from_iata"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HAN"
                    android:textColor="#333333"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_iata_chip_outline"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    tools:text="HAN" />

                <!-- Đường thẳng + icon máy bay -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_marginVertical="4dp">

                    <View
                        android:layout_width="2dp"
                        android:layout_height="28dp"
                        android:background="@color/primary_blue" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_airplane"
                        app:tint="@color/primary_blue" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="28dp"
                        android:background="@color/primary_blue" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_seat_to_iata"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SGN"
                    android:textColor="#333333"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_iata_chip_outline"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    tools:text="SGN" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- ══════════════════════════════════════════
         MAIN BODY: Left (seat map) + Right (plane diagram)
         ══════════════════════════════════════════ -->


    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_gravity="center"
        />

    <!-- ══════════════════════════════════════════
         BOTTOM BAR: Thông tin ghế + 2 nút
         Sticky bottom, elevation cao
         ══════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layout_bottom_seat_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@color/white"
        android:elevation="10dp">

        <!-- Row: Info ghế đang chọn + VAT note -->
        <LinearLayout
            android:id="@+id/layout_selected_seat_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp">

            <!-- Icon seat + text -->
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_seat_illustration"
                android:layout_marginEnd="12dp"
                app:tint="@color/primary_blue" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ghế đang chọn"
                    android:textColor="#888888"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_selected_seat_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vui lòng chọn"
                    android:textColor="#1A1A2E"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="4B, 4E" />

            </LinearLayout>

            <!-- VAT note + giá -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/tv_selected_seat_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#E53935"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="end"
                    tools:text="120.000đ" />

                <TextView
                    android:id="@+id/tv_vat_note"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đã bao gồm VAT"
                    android:textColor="@color/primary_blue"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEEEEE" />

        <!-- Row: 2 nút TRỞ VỀ + TIẾP TỤC -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="12dp">

            <!-- Nút TRỞ VỀ -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_seat_back"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="TRỞ VỀ"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                app:cornerRadius="6dp"
                app:backgroundTint="#BBBBBB" />

            <!-- Nút TIẾP TỤC -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_seat_continue"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="2"
                android:text="TIẾP TỤC"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                app:cornerRadius="6dp"
                app:backgroundTint="@color/primary_blue" />

        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
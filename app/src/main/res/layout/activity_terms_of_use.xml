<?xml version="1.0" encoding="utf-8"?>
<!--
    ══════════════════════════════════════════════════════════════
    activity_terms_of_use.xml

    Màn hình "Điều khoản sử dụng" — mở từ ProfileFragment
    (mục "CẤU HÌNH HỆ THỐNG" → "Điều khoản sử dụng").

    Cấu trúc bám theo đúng ảnh chụp:
      1. Toolbar nền xanh đậm: tiêu đề "12bay.vn" + dòng phụ
         "Điều khoản sử dụng | 12bay.vn"
      2. Banner thông tin nền xanh nhạt: icon (i) + nhãn "Điều khoản sử dụng"
      3. Nội dung điều khoản — dùng WebView vì văn bản pháp lý rất dài,
         load trực tiếp trang điều khoản thật trên 12bay.vn để luôn
         hiển thị đúng & đủ nội dung mới nhất, không phải hard-code
         hàng trăm dòng text trong XML/Java.
    ══════════════════════════════════════════════════════════════
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".ui.view.activity.TermsOfUseActivity">

    <!-- ══════════════════════════════════════════
         TOOLBAR — nền xanh đậm, tiêu đề 2 dòng
         ══════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_blue"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="28dp"
        android:paddingBottom="18dp"
        android:paddingHorizontal="8dp"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/btn_back_terms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:src="@drawable/ic_back"
            app:tint="@color/white"
            tools:ignore="MissingPrefix" />

        <TextView
            android:id="@+id/tv_toolbar_title_terms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/terms_title"
            android:layout_marginStart="15dp"
            android:textColor="@color/white"
            android:textSize="19sp"
            android:textStyle="bold" />

    </LinearLayout>



    <!-- ══════════════════════════════════════════
         NỘI DUNG — WebView load trang điều khoản
         thật trên 12bay.vn (văn bản pháp lý quá dài
         để hard-code, và dễ lỗi thời nếu hard-code)
         ══════════════════════════════════════════ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/webview_terms"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/progress_terms"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:indeterminateTint="#0E6FA3" />

    </FrameLayout>

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    tools:context=".ui.view.activity.SearchFlightActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:elevation="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primary_blue">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbarFlights"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:layout_marginTop="30dp"
                android:paddingStart="4dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:navigationIcon="@drawable/ic_back"
                app:navigationIconTint="@color/white"
                app:title="Danh sách chuyến bay"
                app:titleTextColor="@color/white">
                <!-- Custom title layout inside toolbar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingEnd="16dp">

                    <!-- Route: HÀ NỘI → TP.HCM -->
                    <TextView
                        android:id="@+id/tv_route"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hà Nội  -> TP.HCM"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <!-- Info: 15/05, 1 Người lớn, Phổ thông -->
                        <TextView
                            android:id="@+id/tv_info_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="15/05/2026"
                            android:textColor="#E0E0E0"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/tv_search_adult_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="15dp"
                            android:text="1 "
                            android:textColor="#E0E0E0"
                            android:textSize="16sp" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="26dp"
                            android:src="@drawable/ic_nav_profile"
                            app:tint="@color/white" />

                        <TextView
                            android:id="@+id/tv_search_child_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" 1"
                            android:textColor="#E0E0E0"
                            android:textSize="16sp" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_child"
                            app:tint="@color/white"
                            />

                        <TextView
                            android:id="@+id/tv_search_baby_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1"
                            android:textColor="#E0E0E0"
                            android:textSize="16sp" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_baby"
                            app:tint="@color/white" />


                    </LinearLayout>


                </LinearLayout>

            </com.google.android.material.appbar.MaterialToolbar>

            <!-- Tab Row: LƯỢT ĐI | LƯỢT VỀ (chỉ hiện khi khứ hồi) -->
            <LinearLayout
                android:id="@+id/layout_trip_tabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="8dp"
                android:background="@drawable/bg_tab_container"
                android:orientation="horizontal"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/toolbarFlights"
                tools:visibility="visible">

                <!-- Tab Lượt đi -->
                <TextView
                    android:id="@+id/tab_depart"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_seat_tab_selected"
                    android:gravity="center"
                    android:paddingVertical="10dp"
                    android:text="LƯỢT ĐI"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:alpha="1.0"
                    />

                <!-- Tab Lượt về -->
                <TextView
                    android:id="@+id/tab_return"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_seat_tab_unselected"
                    android:gravity="center"
                    android:paddingVertical="10dp"
                    android:text="LƯỢT VỀ"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- app:layout_behavior="@string/appbar_scrolling_view_behavior" né phần toolbar-->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- RecyclerView flights -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_flights"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:nestedScrollingEnabled="false"
                tools:itemCount="2"
                tools:listitem="@layout/item_flight" />

            <!-- Empty State Container -->

        </FrameLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- FAB Filter  -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center|end"
        android:layout_margin="24dp"
        android:src="@drawable/ic_filter"
        android:contentDescription="Lọc chuyến bay"
        app:tint="@color/white"
        app:backgroundTint="#F44039" />

    <LinearLayout
        android:id="@+id/layout_empty_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:visibility="gone"
        app:layout_anchor="@+id/fab_filter"
        app:layout_anchorGravity="start|bottom"
        tools:visibility="gone">

        <!-- Illustration -->
        <ImageView
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_marginBottom="24dp"
            android:scaleType="fitCenter"
            android:src="@drawable/empty_flight" />

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:text="Không tìm thấy chuyến bay phù hợp!"
            android:textColor="#1A1A1A"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Description -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="Vui lòng chọn ngày khác !"
            android:textColor="#757575"
            android:textSize="14sp" />

        <!-- Button Tìm ngày khác -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_search_other_date"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:backgroundTint="#F44039"
            android:paddingHorizontal="32dp"
            android:text="Tìm ngày khác"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:cornerRadius="28dp"
            app:elevation="4dp" />

    </LinearLayout>
    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_gravity="center"
        />


</androidx.coordinatorlayout.widget.CoordinatorLayout>

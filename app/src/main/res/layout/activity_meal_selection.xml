<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F8"
    tools:context=".ui.view.activity.MealSelectionActivity">

    <!-- ══════════════════════════════════════════
         APPBAR: Toolbar + Tab LƯỢT ĐI / LƯỢT VỀ
         ══════════════════════════════════════════ -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar_meal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_blue"
        app:elevation="4dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_meal"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:layout_marginTop="28dp"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="@color/white"
            app:title="Chọn suất ăn nóng"
            app:titleTextColor="@color/white" />

        <!-- Tab LƯỢT ĐI | LƯỢT VỀ — gone khi 1 chiều -->
        <LinearLayout
            android:id="@+id/layout_meal_tab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="visible"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tab_meal_depart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:text="LƯỢT ĐI"
                android:textColor="#333333"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_seat_tab_selected" />

            <TextView
                android:id="@+id/tab_meal_return"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:text="LƯỢT VỀ"
                android:textColor="#333333"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_seat_tab_unselected" />

        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- ══════════════════════════════════════════
         BODY: RecyclerView danh sách món ăn
         ══════════════════════════════════════════ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_meal_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="12dp"
        android:paddingBottom="160dp"
        android:paddingHorizontal="12dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:listitem="@layout/item_meal" />

    <ProgressBar
        android:id="@+id/progress_bar_meal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- ══════════════════════════════════════════
         BOTTOM BAR: Tóm tắt món đang chọn + 2 nút
         ══════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layout_bottom_meal_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/white"
        android:elevation="10dp"
        android:orientation="vertical">

        <!-- Row: Icon + tên món đang chọn + giá + VAT -->
        <LinearLayout
            android:id="@+id/layout_selected_meal_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_meal_illustration"
                app:tint="@color/primary_blue" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Món đang chọn"
                    android:textColor="#888888"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_selected_meal_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vui lòng chọn"
                    android:textColor="#1A1A2E"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="Cơm gà xào sả ớt" />

            </LinearLayout>

            <!-- Giá + VAT note -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_selected_meal_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="0đ"
                    android:textColor="#E53935"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="344.000đ" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đã bao gồm VAT"
                    android:textColor="@color/primary_blue"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEEEEE" />

        <!-- Row: 2 nút TRỞ VỀ + TIẾP TỤC -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_meal_back"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="TRỞ VỀ"
                android:textAllCaps="true"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="#BBBBBB"
                app:cornerRadius="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_meal_continue"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="2"
                android:text="TIẾP TỤC"
                android:textAllCaps="true"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/primary_blue"
                app:cornerRadius="6dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

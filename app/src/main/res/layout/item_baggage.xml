<?xml version="1.0" encoding="utf-8"?>
<!--
    item_baggage.xml
    Layout cho một gói hành lý trong danh sách chọn của BaggageAdapter.

    Background dùng drawable selector "bg_baggage_selecting":
      - state_selected=true  → viền xanh (#0175F3) + nền xanh nhạt
      - state_selected=false → viền xám + nền trắng
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="12dp"
    android:minWidth="88dp"
    android:background="@drawable/bg_baggage_selecting"
    android:clickable="true"
    android:focusable="true"
    android:layout_marginEnd="8dp">


    <!-- Số kg: "20 kg" — GONE nếu weightKg = 0 -->
    <TextView
        android:id="@+id/tv_baggage_weight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="20 kg"
        android:textSize="12sp"
        android:gravity="center"
        android:visibility="gone"/>

    <!-- Giá: "Miễn phí" hoặc "+150.000đ" -->
    <TextView
        android:id="@+id/tv_baggage_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Miễn phí"
        android:textSize="12sp"
        android:textColor="#0175F3"
        android:textStyle="bold"
        android:gravity="center"/>

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    tools:context=".ui.view.fragment.HomeFragment">

    <!-- ══════════════════════════════════════════════════════
         APPBAR: Header ảnh nền + title + avatar
         enterAlways → AppBar thu lại khi scroll xuống,
         mở ra khi scroll lên — trải nghiệm tốt cả portrait lẫn landscape
         ══════════════════════════════════════════════════════ -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar_home"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="@color/white"
        android:fitsSystemWindows="true"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing_toolbar_home"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fitsSystemWindows="true"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
            app:contentScrim="@color/primary_blue"
            app:statusBarScrim="@color/primary_blue"
            app:titleEnabled="false">

            <!-- Ảnh nền header -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_bg_header"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:shapeAppearanceOverlay="@style/RoundedBottomCorners"
                android:scaleType="centerCrop"
                android:background="@color/primary_blue"
                android:src="@drawable/world"
                android:fitsSystemWindows="true"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="0.4" />

            <!-- Title + Avatar — pin lại khi collapse -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="48dp"
                android:paddingBottom="16dp"
                >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"

                    app:layout_collapseMode="pin">

                    <TextView
                        android:id="@+id/tv_header_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Đặt Vé Máy Bay"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_size_main"
                        android:textStyle="bold" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgSmallAvatar"
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:layout_marginStart="12dp"
                        android:background="@color/white"
                        android:padding="2dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_nav_profile"
                        app:shapeAppearanceOverlay="@style/CircleImage"
                        app:strokeColor="#BDBDBD"
                        app:strokeWidth="1dp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Hãy khám phá các chuyến bay cùng chúng tôi !!!"
                    android:textColor="@color/white"
                    android:textSize="20dp"
                    />

            </LinearLayout>



        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nested_scroll_home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:fillViewport="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- ════════════════════════════════════════
                 TAB: Một chiều / Khứ hồi
                 ════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/layout_tabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="0dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_one_way"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/blue_primary"
                    android:text="MỘT CHIỀU"
                    android:textAllCaps="false"
                    android:textColor="@color/bg_card_white"
                    app:cornerRadius="24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_round"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/white"
                    android:text="KHỨ HỒI"
                    android:textAllCaps="false"
                    android:textColor="@color/blue_primary"
                    app:cornerRadius="24dp"
                    app:elevation="0dp" />
            </LinearLayout>

            <!-- ════════════════════════════════════════
                 CARD FORM TÌM KIẾM
                 ════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_flight_form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="15dp"

                android:layout_marginVertical="16dp"
                app:cardBackgroundColor="@color/bg_card_white"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    >

                    <!-- ── CARD KHỞI HÀNH TỪ ─────────────────────── -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_from"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:cardBackgroundColor="@android:color/transparent"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:strokeColor="@color/stroke_light_grey"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="16dp">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_flight_takeoff"
                                app:tint="@color/text_main_dark" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/tv_from_city"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Hà Nội "
                                        android:textColor="@color/text_main_dark"
                                        android:textSize="18sp" />

                                    <TextView
                                        android:id="@+id/tv_from_code"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="8dp"
                                        android:text="HAN"
                                        android:textColor="@color/text_sub_grey"
                                        android:textSize="14sp" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tv_from_airport"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Nội Bài"
                                    android:textColor="@color/text_hint_light"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Label nổi "Khởi hành từ" -->
                    <TextView
                        android:id="@+id/tv_label_from"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:background="@color/bg_card_white"
                        android:paddingHorizontal="4dp"
                        android:text="Khởi hành từ"
                        android:textColor="@color/text_title"
                        android:textSize="15sp"
                        app:layout_constraintBottom_toTopOf="@+id/card_from"
                        app:layout_constraintStart_toStartOf="@+id/card_from"
                        app:layout_constraintTop_toTopOf="@+id/card_from" />

                    <!-- ── FAB HOÁN ĐỔI ────────────────────────────── -->
                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/fab_swap"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="24dp"
                        app:backgroundTint="@color/bg_card_white"
                        app:elevation="4dp"
                        app:layout_constraintBottom_toTopOf="@id/card_to"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/card_from"
                        app:maxImageSize="30dp"
                        app:pressedTranslationZ="8dp"
                        app:srcCompat="@drawable/ic_swap_vertical" />

                    <!-- ── CARD ĐẾN ───────────────────────────────── -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_to"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:cardBackgroundColor="@android:color/transparent"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:layout_constraintTop_toBottomOf="@id/card_from"
                        app:strokeColor="@color/stroke_light_grey"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="16dp">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_flight_land"
                                app:tint="@color/text_main_dark" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/tv_to_city"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="TP.Hồ Chí Minh"
                                        android:textColor="@color/text_main_dark"
                                        android:textSize="18sp" />

                                    <TextView
                                        android:id="@+id/tv_to_code"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="8dp"
                                        android:text="SGN"
                                        android:textColor="@color/text_sub_grey"
                                        android:textSize="14sp" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tv_to_airport"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Tân Sơn Nhất"
                                    android:textColor="@color/text_hint_light"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Label nổi "Đến" -->
                    <TextView
                        android:id="@+id/tv_label_to"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:background="@color/bg_card_white"
                        android:paddingHorizontal="4dp"
                        android:text="Đến"
                        android:textColor="@color/text_title"
                        android:textSize="15sp"
                        app:layout_constraintBottom_toTopOf="@+id/card_to"
                        app:layout_constraintStart_toStartOf="@+id/card_to"
                        app:layout_constraintTop_toTopOf="@+id/card_to" />

                    <!-- ── ROW NGÀY ĐI / NGÀY VỀ ─────────────────── -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layout_row_dates"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        app:layout_constraintTop_toBottomOf="@+id/card_to">

                        <!-- Container Ngày đi -->
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/container_departure"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            app:layout_constraintEnd_toStartOf="@+id/container_return"
                            app:layout_constraintHorizontal_weight="1"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/card_departure"
                                android:layout_width="match_parent"
                                android:layout_height="60dp"
                                android:layout_marginTop="8dp"
                                app:cardBackgroundColor="@android:color/transparent"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp"
                                app:layout_constraintTop_toTopOf="parent"
                                app:strokeColor="@color/stroke_light_grey"
                                app:strokeWidth="1dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center_vertical"
                                    android:paddingHorizontal="12dp">

                                    <ImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:src="@drawable/ic_calendar"
                                        app:tint="@color/text_main_dark" />

                                    <TextView
                                        android:id="@+id/tv_departure_date"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="10dp"
                                        android:text="15/07/2022"
                                        android:textColor="@color/text_main_dark"
                                        android:textSize="15sp" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:background="@color/bg_card_white"
                                android:paddingHorizontal="4dp"
                                android:text="Ngày đi"
                                android:textColor="@color/text_title"
                                android:textSize="15sp"
                                app:layout_constraintBottom_toTopOf="@id/card_departure"
                                app:layout_constraintStart_toStartOf="@id/card_departure"
                                app:layout_constraintTop_toTopOf="@id/card_departure" />
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <!-- Container Ngày về -->
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/container_return"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_weight="1"
                            app:layout_constraintStart_toEndOf="@id/container_departure"
                            app:layout_constraintTop_toTopOf="parent">

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/card_return"
                                android:layout_width="match_parent"
                                android:layout_height="60dp"
                                android:layout_marginTop="8dp"
                                app:cardBackgroundColor="@android:color/transparent"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp"
                                app:layout_constraintTop_toTopOf="parent"
                                app:strokeColor="@color/stroke_light_grey"
                                app:strokeWidth="1dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center_vertical"
                                    android:paddingHorizontal="12dp">

                                    <ImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:src="@drawable/ic_calendar"
                                        app:tint="@color/text_main_dark" />

                                    <TextView
                                        android:id="@+id/tv_return_date"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="10dp"
                                        android:textColor="@color/text_main_dark"
                                        android:textSize="15sp" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:background="@color/bg_card_white"
                                android:paddingHorizontal="4dp"
                                android:text="Ngày về"
                                android:textColor="@color/text_title"
                                android:textSize="15sp"
                                app:layout_constraintBottom_toTopOf="@id/card_return"
                                app:layout_constraintStart_toStartOf="@id/card_return"
                                app:layout_constraintTop_toTopOf="@id/card_return" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- ── ROW HÀNH KHÁCH + HẠNG GHẾ ─────────────── -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layout_row_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        app:layout_constraintTop_toBottomOf="@+id/layout_row_dates">

                        <!-- Hành khách -->
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/container_traveller"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/card_traveller"
                                android:layout_width="match_parent"
                                android:layout_height="60dp"
                                android:layout_marginTop="8dp"
                                app:cardBackgroundColor="@android:color/transparent"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp"
                                app:layout_constraintTop_toTopOf="parent"
                                app:strokeColor="#E0E0E0"
                                app:strokeWidth="1dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="horizontal"
                                    android:weightSum="3"
                                    android:gravity="center_vertical"
                                    android:paddingHorizontal="16dp">

                                    <TextView
                                        android:id="@+id/tv_adult_count"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="1 Người lớn"
                                        android:textColor="#212121"
                                        android:textSize="16sp"
                                        android:gravity="start" />

                                    <View
                                        android:layout_width="2dp"
                                        android:layout_height="28dp"
                                        android:background="#E0E0E0" />

                                    <TextView
                                        android:id="@+id/tv_child_count"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="0 Trẻ em"
                                        android:textColor="#212121"
                                        android:textSize="16sp"
                                        android:gravity="center" />

                                    <View
                                        android:layout_width="2dp"
                                        android:layout_height="28dp"
                                        android:background="#E0E0E0" />

                                    <TextView
                                        android:id="@+id/tv_infant_count"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="0 Em bé"
                                        android:textColor="#212121"
                                        android:textSize="16sp"
                                        android:gravity="center" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:background="#FFFFFF"
                                android:paddingHorizontal="4dp"
                                android:text="Hành khách"
                                android:textColor="@color/text_title"
                                android:textSize="12sp"
                                app:layout_constraintBottom_toTopOf="@id/card_traveller"
                                app:layout_constraintStart_toStartOf="@id/card_traveller"
                                app:layout_constraintTop_toTopOf="@id/card_traveller" />
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <!-- Hạng ghế -->
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/container_class"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/container_traveller">

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/card_class"
                                android:layout_width="match_parent"
                                android:layout_height="60dp"
                                android:layout_marginTop="8dp"
                                app:cardBackgroundColor="@android:color/transparent"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp"
                                app:layout_constraintTop_toTopOf="parent"
                                app:strokeColor="@color/stroke_light_grey"
                                app:strokeWidth="1dp">

                                <TextView
                                    android:id="@+id/tv_seat_class_summary"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center_vertical"
                                    android:paddingHorizontal="16dp"
                                    android:text="Phổ thông"
                                    android:textColor="@color/text_main_dark"
                                    android:textSize="16sp" />
                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:background="@color/bg_card_white"
                                android:paddingHorizontal="4dp"
                                android:text="Hạng ghế"
                                android:textColor="@color/text_title"
                                android:textSize="15sp"
                                app:layout_constraintBottom_toTopOf="@id/card_class"
                                app:layout_constraintStart_toStartOf="@id/card_class"
                                app:layout_constraintTop_toTopOf="@id/card_class" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- ── NÚT TÌM CHUYẾN BAY ────────────────────── -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_search_flights"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="32dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/btn_search_selector"
                        android:text="TÌM CHUYẾN BAY"
                        android:textAllCaps="false"
                        android:textSize="18sp"
                        app:backgroundTint="@null"
                        app:cornerRadius="12dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/layout_row_info" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>


        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>